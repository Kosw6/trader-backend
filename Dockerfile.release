# 먼저 gradlew bootJar -PexternalRuntimeConfig 실행. 개발자 YAML 없는 전용 JAR만 허용한다.
FROM eclipse-temurin:17-jre
WORKDIR /app
ARG SOURCE_REVISION=unknown
LABEL org.opencontainers.image.revision=$SOURCE_REVISION
COPY build/libs/trader-deployment.jar /app/app.jar
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
